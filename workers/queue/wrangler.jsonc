{
  "name": "itslive-queue",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itslive-prod",
      "database_id": "5c9c7362-a12a-4751-a7b9-5b7505c3bd66"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "dbcc7a8d8c87479c9ac4d8cce3ec2e88"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "itslive-sites"
    }
  ],

  "queues": {
    "consumers": [
      {
        "queue": "itslive-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "itslive-dlq"
      }
    ]
  }

  // Secrets — set via: npx wrangler secret put RESEND_API_KEY --name itslive-queue
}
